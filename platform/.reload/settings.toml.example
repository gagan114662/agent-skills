# Reload — repo/user-scope settings (#58, ADR-0035). Copy to `.reload/settings.toml` to activate.
#
# Precedence: env < user < repo < managed. This file is the **repo** layer when placed at
# `<repo>/.reload/settings.toml`, or the **user** layer at `~/.reload/settings.toml`. Either is a
# flat list of NON-SECRET settings — secrets NEVER go here (use AGENT_SECRETS, see .env.example).

# Enterprise data-privacy mode. When true, off-platform data egress is disabled (Braintrust trace
# export + the notification webhook). A managed layer can force this on and lock it.
dataPrivacyMode = false

# Files copied into every new agent session's working dir on launch (relative to this dir, or
# absolute). The agent harness runs in that dir, so these become its starting context.
filesToCopy = ["AGENTS.md", "docs/agent-context.md"]

# Base dir under which per-session working dirs are created: `<workspaceRoot>/<sessionId>`.
workspaceRoot = ".reload/workspaces"

# --- #57 deep dev integrations -------------------------------------------------------------------
# NOTE: in TOML, flat keys (like `skills`) must appear BEFORE any `[table]` header, or they get
# absorbed into the preceding table. Keep `skills` here with the other top-level keys.

# Skills the agent should carry across harnesses (synced to both Claude Code and Codex).
skills = ["test-driven-development", "code-review-and-quality"]

# --- #56 Run tab ---------------------------------------------------------------------------------
# How the Run tab starts this project's app for in-app preview. The `command` is TRUSTED project
# config (run via `sh -c` in the session's worktree) — it is NEVER taken from a request, so the Run
# tab can't become arbitrary RCE. The bound localhost port is auto-detected from the command's
# output; set `port` to skip detection, or `readyPattern` (a regex whose first group is the port or a
# full url) to override how detection reads the output.
[run]
command = "pnpm dev"
# port = 3000
# readyPattern = "Local:\\s+http://localhost:(\\d+)"

# Project slash commands: `/name [args]` expands to its prompt and runs in a session. `{{args}}` is
# replaced with the caller's args (data, never shell). These are TRUSTED project config.
[slashCommands.review]
description = "Review a diff for correctness and security"
prompt = "Review this diff for correctness, security, and tests:\n{{args}}"

[slashCommands.fix]
description = "Fix the failing tests"
prompt = "Find and fix the failing tests."

# Canonical MCP servers — one source of truth synced to BOTH Claude Code and Codex (see
# `POST /me/agent-config/sync`). `env` lists variable NAMES the harness should pass through; the
# secret VALUES stay on AGENT_SECRETS and are emitted only as ${VAR} placeholders in synced artifacts.
[mcpServers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]
env = ["GITHUB_TOKEN"]
