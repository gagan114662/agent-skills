# Reload — repo/user-scope settings (#58, ADR-0035). Copy to `.reload/settings.toml` to activate.
#
# Precedence: env < user < repo < managed. This file is the **repo** layer when placed at
# `<repo>/.reload/settings.toml`, or the **user** layer at `~/.reload/settings.toml`. Either is a
# flat list of NON-SECRET settings — secrets NEVER go here (use AGENT_SECRETS, see .env.example).

# Enterprise data-privacy mode. When true, off-platform data egress is disabled (Braintrust trace
# export + the notification webhook). A managed layer can force this on and lock it.
dataPrivacyMode = false

# Files copied into every new agent session's working dir on launch (relative to this dir, or
# absolute). The agent harness runs in that dir, so these become its starting context.
filesToCopy = ["AGENTS.md", "docs/agent-context.md"]

# Base dir under which per-session working dirs are created: `<workspaceRoot>/<sessionId>`.
workspaceRoot = ".reload/workspaces"
