# Sandcastle agent auth (#420). The agent provider resolves the Claude credential from this file or its
# `env` option. In the LIVE ipop integration the credential is NOT read from here — it is injected per
# session from the #192 vault as the tenant's OWN token (SandcastleRuntime passes job.secrets.* to
# claudeCode({ env })). This file is only for running the standalone pilot locally.

# Run `claude setup-token` on the host and paste the token:
CLAUDE_CODE_OAUTH_TOKEN=

# OR use an Anthropic API key instead (uncomment):
# ANTHROPIC_API_KEY=

# Prod sandbox = Vercel Firecracker microVM (Docker-in-Docker is unavailable on Fly — see ADR-0420):
# SANDCASTLE_PROVIDER=vercel
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
