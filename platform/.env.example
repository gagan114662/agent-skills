# Reload platform — local dev defaults (matches docker-compose.yml)
# Copy to .env for local overrides. NEVER commit a real .env.
PORT=3000
DATABASE_URL=postgres://reload:reload@localhost:5433/reload
REDIS_URL=redis://localhost:6379

# Braintrust agent-trace monitoring (https://braintrust.dev) — optional.
# Set BRAINTRUST_API_KEY to send one span per agent session to the project below.
# Leave it empty to disable tracing entirely (no network calls).
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=My Project

# --- Coding-agent harness (#50) ---
# Which agent actually does the work each session.
#   demo (default): a script that echoes the task — dev/CI, no model spend.
#   claude-code:    the real Claude Code CLI (requires the `claude` binary + auth in the runtime).
AGENT_HARNESS=demo
# Path/name of the Claude Code binary (claude-code harness only).
CLAUDE_BIN=claude
# Optional model override passed to Claude Code (e.g. claude-opus-4-8).
ANTHROPIC_MODEL=
# Escape hatch: override the spawned command/args directly (JSON array for ARGS).
# AGENT_HARNESS_CMD=bash
# AGENT_HARNESS_ARGS=["scripts/agent-harness-demo.sh"]

# --- Agent execution runtime (#25, ADR-0025) ---
# `local` (default): run the agent harness as a host child process — no cloud, used by dev/test/CI.
# `sandbox`: run each session in a Vercel Sandbox microVM (https://vercel.com/docs/vercel-sandbox).
AGENT_RUNTIME=local

# Vercel Sandbox auth — only read when AGENT_RUNTIME=sandbox.
# Recommended on Vercel: VERCEL_OIDC_TOKEN (run `vercel link && vercel env pull`).
# Off-Vercel (local against the cloud, external CI): an access token + team + project.
# NEVER commit a real token — keep it in your local, gitignored .env.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Runtime image: node24 (default), node22, or python3.13.
VERCEL_SANDBOX_RUNTIME=node24

# Optional: clone a repo into each sandbox (Conductor "agent on an isolated branch" model).
# Used by the smoke test; leave empty to provision an empty workspace instead.
SANDBOX_REPO_URL=
SANDBOX_REPO_REVISION=


# File-backed config layering (#58, ADR-0035). Precedence: env < user < repo < managed.
# These env vars are the LOWEST layer (the base). The TOML files refine them; managed is the lock.
#   RELOAD_DATA_PRIVACY_MODE  — "true"/"1" disables off-platform egress (Braintrust + notify webhook).
#   RELOAD_FILES_TO_COPY      — JSON array or CSV of files copied into each new session workspace.
#   RELOAD_WORKSPACE_ROOT     — base dir for per-session working dirs (<root>/<sessionId>).
# Path overrides (default: ~/.reload/settings.toml, <cwd>/.reload/settings.toml, /etc/reload/managed.toml):
#   RELOAD_USER_CONFIG, RELOAD_REPO_CONFIG, RELOAD_MANAGED_CONFIG
# NOTE: config files hold NON-SECRET settings only — secrets stay on AGENT_SECRETS (see #25).
RELOAD_DATA_PRIVACY_MODE=
RELOAD_FILES_TO_COPY=
RELOAD_WORKSPACE_ROOT=
