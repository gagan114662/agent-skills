{
  "name": "@reload/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts test/unit && pnpm run test:slow",
    "test:unit": "vitest run --config vitest.config.ts test/unit",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke:conversion": "vitest run --config vitest.integration.config.ts test/integration/conversion-smoke.test.ts",
    "evals": "tsx ../../scripts/run-evals.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:rollback": "tsx src/db/migrate.ts down",
    "db:reset": "tsx src/db/migrate.ts reset",
    "db:seed": "tsx src/db/seed.ts",
    "billing:bootstrap": "tsx src/billing/bootstrap-cli.ts",
    "smoke:demo": "tsx src/runtime/smoke-cli.ts",
    "release:gate": "tsx src/runtime/release-cli.ts",
    "verify:release": "tsx src/runtime/verify-release-cli.ts",
    "first-customer:proof": "tsx src/first-customer/proof-cli.ts",
    "external-paid-work:proof": "tsx src/founder-work/proof-cli.ts",
    "autonomous-venture-loop:proof": "tsx src/venture-loop/proof-cli.ts",
    "model:backfill": "tsx src/runtime/model-backfill-cli.ts",
    "dr:drill": "tsx src/dr/drill-cli.ts",
    "sre:drill": "tsx src/sre/drill-cli.ts",
    "uptime:check": "tsx src/uptime/check-cli.ts",
    "selfqa:run": "tsx src/selfqa/run-cli.ts",
    "changelog:draft": "tsx src/site/changelog-cli.ts",
    "preflight": "tsx scripts/preflight.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "trace:smoke": "tsx scripts/braintrust-smoke.ts",
    "sandbox:smoke": "tsx scripts/vercel-sandbox-smoke.ts",
    "agent:browser-smoke": "tsx scripts/agent-browser-smoke.ts",
    "oauth:doctor": "tsx src/connections/oauth-doctor-cli.ts",
    "imessage:relay": "tsx src/imessage/relay-worker-cli.ts",
    "imessage:relay:doctor": "tsx src/imessage/relay-worker-cli.ts --doctor",
    "room:doctor": "tsx src/messaging/external-room-doctor-cli.ts",
    "outbound:doctor": "tsx src/outbound-channel/outbound-doctor-cli.ts",
    "imessage-room:proof": "tsx src/imessage/proof-cli.ts",
    "soak": "tsx scripts/cloud-e2e-soak.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@reload/shared": "workspace:*",
    "@vercel/sandbox": "^2.1.1",
    "braintrust": "^3.17.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "smol-toml": "^1.6.1",
    "stripe": "^22.2.0",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
