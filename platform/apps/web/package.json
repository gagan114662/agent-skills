{
  "name": "@reload/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && pnpm run prerender",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:gate": "node scripts/content-gate.mjs",
    "deploy:freshness": "node scripts/production-freshness.mjs",
    "deploy:status": "node scripts/production-status.mjs",
    "deploy:prebuilt:freshness": "node scripts/vercel-prebuilt-freshness.mjs",
    "qa:links": "node scripts/live-link-qa.mjs",
    "qa:prod-smoke": "node scripts/production-smoke.mjs",
    "qa:links:test": "node --test scripts/live-link-qa.test.mjs",
    "qa:prod-smoke:test": "node --test scripts/production-smoke.test.mjs",
    "deploy:prebuilt:freshness:test": "node --test scripts/vercel-prebuilt-freshness.test.mjs",
    "deploy:status:test": "node --test scripts/production-status.test.mjs",
    "deploy:freshness:test": "node --test scripts/production-freshness.test.mjs",
    "visual:verify": "node scripts/visual-match.mjs"
  },
  "dependencies": {
    "@reload/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
